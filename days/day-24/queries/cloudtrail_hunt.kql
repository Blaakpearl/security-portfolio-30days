    datetime(2026-06-16T09:01:18Z),"ListRoles","iam.amazonaws.com",
    "198.51.100.99","AssumedRole","novacrest-admin-role","","",0,
    datetime(2026-06-16T09:01:45Z),"ListBuckets","s3.amazonaws.com",
    "198.51.100.99","AssumedRole","novacrest-admin-role","","",0,
