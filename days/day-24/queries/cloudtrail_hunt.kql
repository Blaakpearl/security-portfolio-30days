// =========================================================================
// Day 24 — Sentinel KQL: CloudTrail Cloud Infrastructure Hunt
// NovaCrest Capital Group | AWS Account 123456789012
// =========================================================================
// Requires: AWS CloudTrail → CloudWatch → Sentinel connector
//           or manual ingestion via AWSCloudTrail_CL custom table
// =========================================================================

let HuntStart  = datetime(2026-06-14T00:00:00Z);
let HuntEnd    = datetime(2026-06-21T00:00:00Z);
let AttackerIP = "198.51.100.99";
let AttackerAccount = "987654321099";
let NovaCrestAccount = "123456789012";
let PrivateRanges = dynamic(["10.", "172.16.", "192.168."]);

// ── Simulated CloudTrail events (inline for demo) ─────────────────────
let CloudTrailEvents = datatable(
    EventTime: datetime, EventName: string, EventSource: string,
    SourceIP: string, UserType: string, UserName: string,
    RequestParams: string, ErrorCode: string, BytesOut: long
)[
    datetime(2026-06-16T09:00:11Z),"GetCallerIdentity","sts.amazonaws.com",
    "198.51.100.99","IAMUser","trading-api-deploy","","",0,
    datetime(2026-06-16T09:01:03Z),"ListUsers","iam.amazonaws.com",
