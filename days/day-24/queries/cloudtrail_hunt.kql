    datetime(2026-06-16T09:05:02Z),"StopLogging","cloudtrail.amazonaws.com",
    "198.51.100.99","AssumedRole","novacrest-admin-role",
    "trail/novacrest-main-trail","",0,
    datetime(2026-06-16T09:05:18Z),"UpdateDetector","guardduty.amazonaws.com",
    "198.51.100.99","AssumedRole","novacrest-admin-role","enable=false","",0,
    datetime(2026-06-16T09:10:05Z),"GetSecretValue","secretsmanager.amazonaws.com",
    "198.51.100.99","AssumedRole","novacrest-admin-role",
    "novacrest/bloomberg/api-key","",0,
    datetime(2026-06-16T09:10:22Z),"GetSecretValue","secretsmanager.amazonaws.com",
    "198.51.100.99","AssumedRole","novacrest-admin-role",
    "novacrest/rds/trading-db-password","",0,
    datetime(2026-06-16T09:15:44Z),"CreateUser","iam.amazonaws.com",
    "198.51.100.99","AssumedRole","novacrest-admin-role",
    "svc-monitoring-ops","",0,
    datetime(2026-06-16T09:16:02Z),"AttachUserPolicy","iam.amazonaws.com",
    "198.51.100.99","AssumedRole","novacrest-admin-role",
    "svc-monitoring-ops/AdministratorAccess","",0,
    datetime(2026-06-16T09:16:28Z),"CreateAccessKey","iam.amazonaws.com",
    "198.51.100.99","AssumedRole","novacrest-admin-role",
    "svc-monitoring-ops","",0,
    datetime(2026-06-16T09:18:11Z),"CreateRole","iam.amazonaws.com",
